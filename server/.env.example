# ---- Required ----
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/codeit
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Optional ----
# Free account at clist.by -> API key. Without these, contests come from Codeforces only.
CLIST_USERNAME=
CLIST_API_KEY=
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
