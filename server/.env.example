# ---- Required ----
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/codeit
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Optional ----
# Free account at clist.by -> API key. Without these, contests come from Codeforces only.
CLIST_USERNAME=
CLIST_API_KEY=
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Contest reminder emails (optional). Any SMTP server works. For Gmail: turn on 2-step
# verification, create an App Password, and use smtp.gmail.com, port 587, your address,
# and that 16-character app password (never your normal password).
# Without these, reminders are printed in the server terminal instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# For testing only: send reminders this many minutes ahead instead of 30 (e.g. 1440 = 24 hours).
REMINDER_LEAD_MINUTES=
